{
  "name": "paseo-latex-companion",
  "version": "1.0.0",
  "description": "A LaTeX display companion for the official Better Paseo plugin on web and desktop.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test": "node --test test/project.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "marked": "17.0.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
