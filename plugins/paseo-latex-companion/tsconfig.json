{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react"],
    "jsx": "react-jsx",
    "strict": true,
    // Preserve the published IIFE bytes when esbuild also reads this config.
    "alwaysStrict": false,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["client/**/*.ts", "client/**/*.tsx"]
}
